# SysRevAI Environment Variables
# Add these in Vercel Project Settings -> Environment Variables or local .env

# Semantic Scholar API Key (Graph API v1) - recommended for production rate limits
# Apply at https://www.semanticscholar.org/product/api#api-key-form
S2_API_KEY=

# OpenAlex API Key (Works API) - recommended for production rate limits
# Register at https://openalex.org/
OPENALEX_API_KEY=
