# SysRevAI Environment Variables
# Add these in Vercel Project Settings -> Environment Variables or local .env

# Semantic Scholar API Key (Graph API v1) - recommended for production rate limits
# Apply at https://www.semanticscholar.org/product/api#api-key-form
S2_API_KEY=

# OpenAlex API Key (Works API) - recommended for production rate limits
# Register at https://openalex.org/
OPENALEX_API_KEY=

# NCBI E-utilities (PubMed / MEDLINE + Cochrane CDSR journal filter) - optional; raises the limit from 3 to 10 req/s
# Create one at https://www.ncbi.nlm.nih.gov/account/settings/ (API Key Management)
NCBI_API_KEY=

# Contact e-mail NCBI asks every E-utilities client to send (tool=sysrevai&email=...)
# See https://www.ncbi.nlm.nih.gov/books/NBK25497/
NCBI_EMAIL=

# SerpApi key - REQUIRED for Google Scholar (Google Scholar has no official API and is never scraped)
# Without it Google Scholar is reported as "not configured" in the app, PRISMA and Methods. Sign up at https://serpapi.com/
SERPAPI_KEY=
